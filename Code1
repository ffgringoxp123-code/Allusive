-- Bitwise XOR implementation
local function bxor(x, y)
    local r, b = 0, 1
    while x > 0 or y > 0 do
        if (x % 2) ~= (y % 2) then r = r + b end
        x, y, b = math.floor(x/2), math.floor(y/2), b*2
    end
    return r
end

