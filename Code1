-- Decode all strings
for i=1,#a do
    local s = a[i]
    if type(s) == "string" and #s > 0 then
        local prefix = s:sub(1,1)
        local enc = s:sub(2)
        
        if prefix == "-" then
            -- Base64 decode
            local out, idx, D, V = {}, 1, 0, 0
            while idx <= #enc do
                local ch = enc:sub(idx,idx)
                local val = b64[ch]
                if val then
                    D = D + val * (64 ^ (3 - V))
                    V = V + 1
                    if V == 4 then
                        V = 0
                        table.insert(out, string.char(
                            math.floor(D / 65536),
                            math.floor((D % 65536) / 256),
                            D % 256
                        ))
                        D = 0
                    end
                elseif ch == "=" then
                    table.insert(out, string.char(math.floor(D / 65536)))
                    if idx < #enc and enc:sub(idx+1,idx+1) ~= "=" then
                        table.insert(out, string.char(math.floor((D % 65536) / 256)))
                    end
                    break
                end
                idx = idx + 1
            end
            a[i] = table.concat(out)
            
        elseif prefix == "}" then
            -- Ascii85 decode
            local out, idx = {}, 1
            while idx <= #enc do
                local rem = #enc - idx + 1
                local cl = rem >= 5 and 5 or rem
                local val, ok = 0, (cl > 1)
                for o = 0, 4 do
                    if o < cl then
                        local v = a85[enc:sub(idx+o, idx+o)]
                        if not v then ok = false; break end
                        val = val * 85 + v
                    else
                        val = val * 85 + 84
                    end
                end
                if ok then
                    local b1 = math.floor(val / 16777216) % 256
                    local b2 = math.floor(val / 65536) % 256
                    local b3 = math.floor(val / 256) % 256
                    local b4 = val % 256
                    if cl == 5 then table.insert(out, string.char(b1,b2,b3,b4))
                    elseif cl == 4 then table.insert(out, string.char(b1,b2,b3))
                    elseif cl == 3 then table.insert(out, string.char(b1,b2))
                    elseif cl == 2 then table.insert(out, string.char(b1)) end
                end
                idx = idx + cl
            end
            a[i] = table.concat(out)
        end
    end
end

