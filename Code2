                    D = D + val * (64 ^ (3 - V))
                    V = V + 1
                    if V == 4 then
                        V = 0
                        table.insert(out, string.char(
                            math.floor(D / 65536),
                            math.floor((D % 65536) / 256),
                            D % 256
                        ))
                        D = 0
                    end
                elseif ch == "=" then
                    table.insert(out, string.char(math.floor(D / 65536)))
                    if idx >= #L or L:sub(idx+1, idx+1) ~= "=" then
                        table.insert(out, string.char(math.floor((D % 65536) / 256)))
                    end
                    break
                end
                idx = idx + 1
            end
            a[i] = table.concat(out)
            
        elseif prefix == "}" then
            -- ASCII85 DECODE
            L = L:sub(2)
            local out, idx = {}, 1
            
            while idx <= #L do
                local remaining = (#L - idx) + 1
                local chunk_len = remaining >= 5 and 5 or remaining
                local val, valid = 0, (chunk_len > 1)
                
                for offset = 0, 4 do
                    if offset < chunk_len then
                        local ch = L:sub(idx + offset, idx + offset)
                        local v = d[ch]
                        if not v then valid = false; break end
                        val = val * 85 + v
                    else
                        val = val * 85 + 84  -- padding ~
                    end
                end
                
                if valid then
                    local b1 = math.floor(val / 16777216) % 256
                    local b2 = math.floor(val / 65536) % 256
                    local b3 = math.floor(val / 256) % 256
                    local b4 = val % 256
                    
