-- Hàm bxor nếu không có bit32
if not bit32 then
    function bit32.bxor(a, b)
        local result, bitval = 0, 1
        while a > 0 or b > 0 do
            if (a % 2) ~= (b % 2) then result = result + bitval end
            a, b, bitval = math.floor(a/2), math.floor(b/2), bitval * 2
        end
        return result
    end
end

