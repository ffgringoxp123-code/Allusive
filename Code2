            print(string.format("J(%d) = [BINARY %d bytes] %s%s  -- index=%d", 
                idx, #val, table.concat(hex, " "), suffix, i))
        end
    else
        print(string.format("J(%d) = (empty)  -- index=%d", idx, i))
    end
end

